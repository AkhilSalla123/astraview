# Optional: N2YO key (https://www.n2yo.com/api/). Without it, CelesTrak is used for TLEs.
N2YO_API_KEY=
# MongoDB URI (default points to local container 'mongo:27017' when using Docker, or localhost:27017 when running locally)
# MONGODB_URI=mongodb://localhost:27017/astraview
# Ports configuration (optional overrides)
PORT_FRONTEND=3000
PORT_BACKEND=8080
PORT_ORBIT=8000
PORT_MONGO=27017
